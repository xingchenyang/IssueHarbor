<Project Sdk="MSTest.Sdk/4.1.0">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Corvus.Text.Json.Validator" Version="5.2.12" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../src/Analyzer/Contracts/analysis-result-v1.schema.json"
          Link="Contracts/analysis-result-v1.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Analyzer/Storage/Migrations/*.sql"
          Link="Storage/Migrations/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="SourceContext/GitProcessStub/**/*.cs" />
    <Compile Remove="SourceContext/GitRemoteProbe/**/*.cs" />
    <ProjectReference Include="../../src/Analyzer/IssueHarbor.Analyzer.csproj" />
    <ProjectReference Include="SourceContext/GitProcessStub/GitProcessStub.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="SourceContext/GitRemoteProbe/GitRemoteProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
